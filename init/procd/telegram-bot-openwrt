#!/bin/sh /etc/rc.common

# Required for procd
START=99
STOP=10

USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /root/telegram-bot-openwrt/main.py
    procd_set_param respawn  # Ensures the service restarts if it crashes
    procd_set_param stdout 1 # Redirect stdout to log
    procd_set_param stderr 1 # Redirect stderr to log
    procd_close_instance
}

stop_service() {
    # procd will automatically handle service termination, so this can be left empty
    return 0
}
